{
  "name": "solito-expo-router",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.21",
    "@types/react-native": "^0.72.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.21.0",
    "turbo": "^1.4.2",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "web": "cd apps/next && yarn next",
    "dev": "concurrently \"yarn web\" \"yarn native\"",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  "dependencies": {
    "@gluestack-style/react": "^1.0.15",
    "@gluestack-ui/config": "^1.0.3",
    "@gluestack-ui/themed": "^1.0.13",
    "@gluestack/ui-next-adapter": "^2.1.10",
    "@swc/helpers": "^0.5.18",
    "concurrently": "^9.0.0",
    "expo": "~54.0.0",
    "expo-dev-client": "~5.0.0",
    "@expo/metro-runtime": "~6.1.2",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-constants": "~18.0.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "^15.0.0",
    "react-native-web": "^0.19.13",
    "react-native-worklets": "0.5.1",
    "@radix-ui/react-compose-refs": "^1.0.0",
    "@radix-ui/react-slot": "^1.0.0"
  },
  "version": "1.0.0"
}